# Copy to .env and fill in. .env is git-ignored and is only read by the pipeline.
# NASA Earthdata login (free): https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# OpenAI API key for the natural-language explanation step: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the OpenAI model used for explanations
OPENAI_MODEL=gpt-5-mini
